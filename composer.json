{
    "name": "cloudbss/kernel",
    "description": "CloudBSS enterprise kernel \u2014 event-sourced double-entry accounting/decision core. infra/ adds Postgres persistence, sales + purchase ledger slices (VAT both sides), and trial-balance/P&L reporting.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*"
    },
    "suggest": {
        "ext-pdo_pgsql": "Required by the infra/ Postgres persistence adapter"
    },
    "autoload": {
        "psr-4": {
            "CloudBSS\\Kernel\\": "src/",
            "CloudBSS\\App\\": "app/",
            "CloudBSS\\Infra\\": "infra/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CloudBSS\\Kernel\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run.php",
        "stress": "php tests/stress.php",
        "test-persistence": "php infra/tests/persistence_test.php",
        "test-slice": "php infra/tests/sales_slice_test.php",
        "test-books": "php infra/tests/books_test.php",
        "test-payments": "php infra/tests/payments_test.php",
        "test-aging": "php infra/tests/aging_test.php"
    }
}